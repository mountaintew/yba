{
  "manifest_version": 3,
  "name": "Yba",
  "version": "1.0.0",
  "description": "An assistant for deslopping interfaces. Preview fixes on any page and export instructions for your coding agent.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Deslop this page (Alt+Shift+D)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "toggle-yba": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle the Yba bar"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
